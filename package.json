{
  "name": "homegentic",
  "version": "0.1.0",
  "description": "Blockchain-verified home maintenance history platform on Internet Computer Protocol",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "deploy": "bash scripts/deploy.sh",
    "deploy:testnet": "bash scripts/deploy.sh --network testnet",
    "start": "dfx start --background",
    "stop": "dfx stop",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cd frontend && npm run test:unit",
    "test:unit:watch": "cd frontend && npm run test:unit:watch",
    "test:unit:coverage": "cd frontend && npm run test:unit:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "bash scripts/test-integration.sh",
    "test:canister": "bash scripts/test-backend.sh",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:upgrade": "cd tests/upgrade && npm test",
    "setup:pocketic": "bash scripts/setup-pocketic.sh",
    "frontend": "cd frontend && npm run dev",
    "generate": "dfx generate",
    "status": "bash scripts/status.sh",
    "upgrade": "bash scripts/upgrade.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip --workspace frontend --production",
    "check:motoko-warnings": "bash scripts/ci/check-motoko-warnings.sh",
    "gen:declaration-types": "node --experimental-strip-types --no-warnings scripts/gen-declaration-types.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@dfinity/internet-identity-playwright": "^3.0.0",
    "@playwright/test": "^1.44.0",
    "axe-playwright": "^2.2.2",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
