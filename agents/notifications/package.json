{
  "name": "@homegentic/notifications",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc",
    "start": "node dist/agents/notifications/server.js",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "babel-jest",
      "^.+\\.m?js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.*/node_modules/)?(@noble|@scure)/)"
    ]
  },
  "dependencies": {
    "@icp-sdk/core": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^7.28.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
