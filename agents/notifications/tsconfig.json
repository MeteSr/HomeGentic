{
  "compilerOptions": {
    "target":          "ES2020",
    "module":          "CommonJS",
    "lib":             ["ES2020"],
    "outDir":          "./dist",
    "rootDir":         ".",
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "resolveJsonModule": true,
    "paths": {
      "@icp-sdk/core/agent":     ["./node_modules/@icp-sdk/core/lib/cjs/agent/index.d.ts"],
      "@icp-sdk/core/identity":  ["./node_modules/@icp-sdk/core/lib/cjs/identity/index.d.ts"],
      "@icp-sdk/core/principal": ["./node_modules/@icp-sdk/core/lib/cjs/principal/index.d.ts"]
    }
  },
  "include":  ["*.ts", "__tests__/**/*.ts"],
  "exclude":  ["node_modules", "dist"]
}
