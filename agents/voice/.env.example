# ── Required in production ────────────────────────────────────────────────────
NODE_ENV=production

# Claude API — server-side only, never a VITE_ var
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret between frontend and this server (x-api-key header)
VOICE_AGENT_API_KEY=your-secret-here

# Exact origin of the frontend canister (no trailing slash)
# Testnet: https://eybo6-7yaaa-aaaaj-a6mva-cai.ic0.app
FRONTEND_ORIGIN=https://<frontend-canister-id>.ic0.app

# Stripe live keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Stripe Price IDs (create in Stripe Dashboard → Products) ──────────────────
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_CONTRACTOR_PRO_MONTHLY=price_...
STRIPE_PRICE_CONTRACTOR_PRO_YEARLY=price_...
STRIPE_PRICE_CREDITS_25=price_...
STRIPE_PRICE_CREDITS_100=price_...

# ── ICP canister calls (replaces dfx shell-outs) ─────────────────────────────
# Same PEM used by the deploy identity — must be admin in the payment canister
DFX_IDENTITY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Network routing for paymentCanister.ts:
#   local  → http://localhost:4943  (dfx replica, fetchRootKey called automatically)
#   <unset> or anything else → https://ic0.app  (IC mainnet)
# DFX_NETWORK=local

# Canister IDs (required — there are no hard-coded fallbacks; see canister_ids.json)
#   CANISTER_ID_PAYMENT  Stripe activations, agent credits, tier lookups
#   CANISTER_ID_AUTH     resolves x-agent-session tokens to the caller's principal.
#                        Leave unset in local dev AND set NODE_ENV=development to
#                        fall back to the unverified x-icp-principal header instead.
# CANISTER_ID_PAYMENT=hnx5s-iyaaa-aaaaj-qsgqa-cai
# CANISTER_ID_AUTH=

# ── Optional ──────────────────────────────────────────────────────────────────
# Railway/Render inject PORT automatically; VOICE_AGENT_PORT overrides if set
# VOICE_AGENT_PORT=3001
