{
  "name": "@homegentic/voice-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "babel-jest",
      "^.+\\.m?js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "*.ts",
      "src/**/*.ts",
      "!*.test.ts",
      "!types.ts",
      "!jest.config.ts"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 77,
        "functions": 76,
        "branches": 67,
        "statements": 74
      }
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.*/node_modules/)?(@noble|@scure)/)"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@icp-sdk/core": "^6.1.1",
    "postal-mime": "4.2.0",
    "resend": "^6.37.0",
    "stripe": "^23.1.0"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "babel-jest": "^30.5.0",
    "dotenv": "^18.0.9",
    "jest": "^30.5.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
