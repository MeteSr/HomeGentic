# Copy this file to .dev.vars and fill in real values for local development.
# .dev.vars is gitignored — never commit real secrets.
#
# Production secrets are set with:
#   wrangler secret put RESEND_API_KEY
#   wrangler secret put ROUTE_CONFIG

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Per-origin routing config (JSON array).
# origin    — exact Origin header value from the browser (no trailing slash)
# toEmail   — who receives the lead notification
# fromEmail — sender address (domain must be verified in Resend: https://resend.com/domains)
# fromName  — display name shown in the From field
#
# For local development, add http://localhost entries matching your dev server port.
ROUTE_CONFIG=[{"origin":"https://sellingpelicanbay.com","toEmail":"info@sellingpelicanbay.com","fromEmail":"noreply@sellingpelicanbay.com","fromName":"Williamson Real Estate"},{"origin":"https://homegentic.app","toEmail":"info@homegentic.app","fromEmail":"noreply@homegentic.app","fromName":"HomeGentic"},{"origin":"http://localhost:8080","toEmail":"dev@example.com","fromEmail":"dev@example.com","fromName":"Dev Test"},{"origin":"http://localhost:5173","toEmail":"dev@example.com","fromEmail":"dev@example.com","fromName":"Dev Test"}]
